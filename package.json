{
  "name": "telegram-beats-self-hosted",
  "version": "1.4.1",
  "private": true,
  "description": "Telegram Beats music player with a small streaming/search backend",
  "scripts": {
    "postinstall": "node -e \"const {YtDlp}=require('ytdlp-nodejs'); new YtDlp().downloadYtDlp().then(()=>console.log('yt-dlp binary downloaded')).catch(e=>console.error(e))\"",
    "start": "node server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ytdlp-nodejs": "^3.4.5",
    "youtube-music-api": "latest"
  }
}
